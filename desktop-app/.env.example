# Rename/copy to .env. Never commit real API keys.
# Rule-based audit works without AI.

# Local Ollama (optional):
AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# Or cloud GigaChat (optional):
# AI_PROVIDER=gigachat
# GIGACHAT_CREDENTIALS=
# GIGACHAT_MODEL=GigaChat
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GIGACHAT_CA_BUNDLE=
