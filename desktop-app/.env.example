# Copy this file to .env. Never commit real API keys.
# Rule-based audit works without an AI model.

# Optional local Ollama:
AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# Or optional cloud GigaChat:
# AI_PROVIDER=gigachat
# GIGACHAT_CREDENTIALS=
# GIGACHAT_MODEL=GigaChat
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GIGACHAT_CA_BUNDLE=
