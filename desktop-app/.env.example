# Copy to .env. Never commit real API keys.
# Recommended fast Gemini model:
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Crawl speed defaults (UI preset can override these):
CRAWL_MAX_PAGES=40
CRAWL_MAX_DOCUMENTS=8
CRAWL_SECONDS=90
CRAWL_TIMEOUT=6
CRAWL_DELAY=0.15

# Optional alternatives:
# AI_PROVIDER=ollama
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=
# AI_PROVIDER=gigachat
# GIGACHAT_CREDENTIALS=
# GIGACHAT_MODEL=GigaChat
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
